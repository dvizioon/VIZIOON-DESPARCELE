{
  "name": "desparcele",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-serve.cjs dev",
    "build": "next build",
    "start": "node scripts/next-serve.cjs start",
    "lint": "next lint",
    "db:generate": "node scripts/with-db-url.cjs npx prisma generate",
    "db:migrate": "node scripts/with-db-url.cjs npx prisma migrate dev",
    "db:push": "node scripts/with-db-url.cjs npx prisma db push",
    "db:seed": "node scripts/with-db-url.cjs node prisma/seed.mjs",
    "db:seed:demo": "node scripts/with-db-url.cjs tsx prisma/seed.ts",
    "db:studio": "node scripts/with-db-url.cjs npx prisma studio",
    "postinstall": "node scripts/with-db-url.cjs npx prisma generate && node scripts/copy-tinymce.cjs"
  },
  "prisma": {
    "seed": "node scripts/with-db-url.cjs node prisma/seed.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iconify/react": "^5.2.1",
    "@prisma/client": "^6.5.0",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tinymce/tinymce-react": "^6.3.0",
    "bcryptjs": "^3.0.2",
    "gsap": "^3.15.0",
    "next": "^15.2.4",
    "next-auth": "5.0.0-beta.25",
    "nodemailer": "^6.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-google-charts": "^5.2.1",
    "tinymce": "^8.9.1",
    "tinymce-i18n": "^26.9.28",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/gsap": "^1.20.2",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.4",
    "postcss": "^8.5.3",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
