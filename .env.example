# ========================================
# Ambiente — development | production | test
# ========================================
NODE_ENV=development

# ========================================
# Banco de Dados
# ========================================
DB_HOST=localhost
DB_PORT=9867
DB_NAME=desparcele
DB_USER=postgres
DB_PASS=postgres

# ========================================
# Backend
# ========================================
AUTH_SECRET=your_secret_32_chars_minimum_here
AUTH_URL=http://localhost:7250
# NEXTAUTH_URL=http://localhost:7250
# AUTH_TRUST_HOST=true
# HOST=0.0.0.0
PORT=7250

# ========================================
# S3
# ========================================
S3_ENABLED=false
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_PORT=9000
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_USE_SSL=false

# ========================================
# Local Storage
# ========================================
LOCAL_STORAGE_PATH=./storage

# ========================================
# Seed
# ========================================
SEED_MASTER_EMAIL=admin@admin.com
SEED_MASTER_PASSWORD=admin123
SEED_MASTER_NAME=Admin
